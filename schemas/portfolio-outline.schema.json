{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-harness.local/schemas/portfolio-outline.schema.json",
  "title": "Career Portfolio Outline",
  "type": "object",
  "required": ["version", "title", "theme", "slides"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "title": {"type": "string", "minLength": 1},
    "theme": {"enum": ["editorial", "minimal", "technical"]},
    "slides": {
      "type": "array",
      "minItems": 7,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "type", "layout", "purpose", "title", "claim_ids", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "type": {"enum": ["cover", "career-map", "project-overview", "problem", "architecture", "decision", "workflow", "evidence", "results", "role", "closing"]},
          "layout": {"enum": ["lead", "split", "evidence"]},
          "purpose": {"type": "string", "minLength": 1},
          "eyebrow": {"type": "string"},
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string"},
          "body": {"type": "array", "items": {"type": "string"}},
          "bullets": {"type": "array", "maxItems": 6, "items": {"type": "string"}},
          "metrics": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["value", "label"],
              "properties": {
                "value": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "image": {"type": "string"},
          "image_alt": {"type": "string"},
          "caption": {"type": "string"},
          "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^claim-[a-z0-9]+(?:-[a-z0-9]+)*$"}},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence-[a-z0-9]+(?:-[a-z0-9]+)*$"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
